rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // Must be an authenticated user
      return isAuthenticated();
    }

    // Site Configuration Rules
    match /siteConfig/{docId} {
      // Public can read only if published is true or if admin
      allow read: if (resource == null || resource.data.published == true) || isAdmin();
      // Only authenticated admins can write
      allow write: if isAdmin();
    }

    // Competitions Collection Rules
    match /competitions/{competitionId} {
      // Public can read only published competitions
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      // Only authenticated admins can create, update, or delete
      allow write: if isAdmin();
    }

    // Announcements Collection Rules
    match /announcements/{announcementId} {
      // Public can read active published announcements
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      // Only authenticated admins can create, update, or delete
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
